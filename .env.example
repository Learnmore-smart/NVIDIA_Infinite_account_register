# Copy values into your local .env (never commit real secrets).
# Bare nvapi-* lines may also appear here — ResultStore appends successful API keys.

# --- CapSolver (captcha) ---
CAPSOLVER_API_KEY=

# --- Gmail API (verification codes, plus-addressing) ---
# 1) Create OAuth client in Google Cloud; enable Gmail API.
# 2) Authorized redirect URI: http://localhost:8080/api/gmail/callback
# 3) Fill CLIENT_ID + CLIENT_SECRET, then use the dashboard button
#    「用 Google 登录并连接 Gmail」 to obtain refresh token automatically.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_MAILBOX=
# Optional override if not using localhost:8080
# GMAIL_REDIRECT_URI=http://localhost:8080/api/gmail/callback

# --- Optional: IMAP instead of Gmail API ---
# EMAIL_CODE_PROVIDER=imap
# TEST_GMAIL_EMAIL=
# TEST_GMAIL_APP_PASSWORD=
